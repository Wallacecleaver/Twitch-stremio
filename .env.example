# TwitchIO sur VPS (WDook / Docker)
# Tout le reste (Cloudflare, API Twitch, relais, adresse publique…) se règle ensuite dans le dashboard : /admin → Paramètres → Configuration.

# Mot de passe du dashboard /admin.
# Laisse vide : un mot de passe est généré au 1er démarrage et affiché dans les logs du conteneur (puis conservé).
ADMIN_PASSWORD=

# Clé de chiffrement des jetons (liens d'installation, jetons saisis dans le dashboard).
# Laisse vide : générée au 1er démarrage et conservée. La changer invalide les liens avec un compte Twitch lié.
SECRET=

# Port d'écoute dans le conteneur (le champ « Port de l'addon » de WDook).
PORT=7000

# Facultatif : adresse publique https de l'addon (sinon déduite de la requête, ce qui marche derrière Caddy).
#PUBLIC_URL=https://mon-addon.duckdns.org

# Facultatif : délai (ms) entre deux écritures de data.json quand les statistiques bougent (défaut 15000, minimum 2000).
# Plus c'est grand, moins le disque est sollicité ; un arrêt propre (docker stop) enregistre toujours tout.
#SAVE_DELAY_MS=15000
